{
	"name": "little-city",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "FORCE_COLOR=3 bun run --filter '@little-city/web' dev",
		"build": "FORCE_COLOR=3 bun run --filter '@little-city/web' build",
		"preview": "FORCE_COLOR=3 bun run --filter '@little-city/web' preview",
		"test": "bun run --filter '*' test",
		"format": "bunx --bun @biomejs/biome format --write",
		"lint": "bunx --bun @biomejs/biome lint"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"@types/bun": "latest"
	},
	"peerDependencies": {
		"typescript": "^5"
	}
}
