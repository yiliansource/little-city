{
	"compilerOptions": {
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"moduleDetection": "force",
		"types": ["bun"],

		"resolveJsonModule": true,
		"verbatimModuleSyntax": true,
		"composite": true,
		"declaration": true,

		"strict": true,
		"skipLibCheck": true,

		"noFallthroughCasesInSwitch": true,
		"noImplicitOverride": true
	}
}
